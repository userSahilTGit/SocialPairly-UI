# Copy to .env and adjust per environment.

VITE_API_URL=

# Production site URL (no trailing slash). Enables canonical/og:url tags, absolute og:image,
# JSON-LD URLs and sitemap.xml. Leave empty until the production domain (DNS) is live.
VITE_SITE_URL=

# Idle session timeout: minutes of inactivity before the "Stay logged in?" dialog opens,
# and seconds the dialog counts down before signing the user out.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=15
VITE_SESSION_WARNING_SECONDS=60
