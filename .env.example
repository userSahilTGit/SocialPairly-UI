# Copy to .env and adjust per environment.

VITE_API_URL=

# Production site URL (no trailing slash). Enables canonical/og:url tags, absolute og:image,
# JSON-LD URLs and sitemap.xml.
VITE_SITE_URL=https://www.socialpairly.com

# Google / Apple Sign-In
# GCP Web client cannot use wildcard ports — each http://localhost:<port> (and
# matching http://127.0.0.1:<port>) must be listed under Authorized JavaScript origins.
# Prefer: npm run dev  →  http://localhost:3000/signin  (port 3000 is the default).
# VITE_DEV_PORT=3000
# VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=com.socialpairly.web
# VITE_APPLE_REDIRECT_URI=https://www.socialpairly.com/signin

# Idle session timeout: minutes of inactivity before the "Stay logged in?" dialog opens,
# and seconds the dialog counts down before signing the user out.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=15
VITE_SESSION_WARNING_SECONDS=60
